#!/usr/bin/env python3
"""Visible control console for Claude-to-Feishu synchronization."""

from __future__ import annotations

import json
import os
import select
import shutil
import subprocess
import sys
import threading
from pathlib import Path
from typing import Callable, Optional

from pm_feishu import (
    KEYCHAIN_ACCOUNT,
    KEYCHAIN_SERVICE,
    acquire_gateway_lock,
    append_log,
    deliver_pending,
    is_configured,
    load_boss,
    load_state,
    pending_events,
    runtime_dir,
    save_lark_channel,
    send_text,
    set_enabled,
)
from pm_feishu_inbound import (
    inbound_configured,
    listen_forever,
    listener_runtime_status,
    process_pending_once,
)


class GatewayCommandStop(threading.Event):
    def is_set(self) -> bool:
        return super().is_set() or not bool(load_state().get("enabled"))


class ActiveCommandCancellation:
    """Own the cancellation event for the one serialized remote command."""

    def __init__(self) -> None:
        self._lock = threading.Lock()
        self._current: Optional[threading.Event] = None

    def begin(self) -> threading.Event:
        event = GatewayCommandStop()
        with self._lock:
            self._current = event
        return event

    def finish(self, event: threading.Event) -> None:
        with self._lock:
            if self._current is event:
                self._current = None

    def cancel(self) -> None:
        with self._lock:
            event = self._current
        if event is not None:
            event.set()


def status_text() -> str:
    state = load_state()
    boss = load_boss()
    mode = "ON" if state.get("enabled") else "OFF"
    session = str(boss.get("session_id") or "not-bound")[:12]
    connection = "configured" if is_configured() else "not-configured"
    duplex = (
        listener_runtime_status() if inbound_configured() else "not-configured"
    )
    return (
        f"{mode} | Feishu {connection} | "
        f"Duplex {duplex} | boss {session} | pending {len(pending_events())}"
    )


def _find_lark_channel(name: str = "Claude PM 总控") -> str:
    executable = shutil.which("lark-cli")
    if not executable:
        return ""
    result = subprocess.run(
        [
            executable,
            "im",
            "+chat-search",
            "--as",
            "user",
            "--query",
            name,
            "--format",
            "json",
        ],
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        return ""
    chats = response.get("data", {}).get("chats", [])
    exact = [chat for chat in chats if chat.get("name") == name]
    if result.returncode == 0 and len(exact) == 1:
        return str(exact[0].get("chat_id", ""))
    return ""


def _lark_owner_open_id() -> str:
    executable = shutil.which("lark-cli")
    if not executable:
        return ""
    result = subprocess.run(
        [executable, "auth", "status"],
        capture_output=True,
        text=True,
        check=False,
    )
    try:
        response = json.loads(result.stdout)
    except json.JSONDecodeError:
        return ""
    user = response.get("identities", {}).get("user", {})
    open_id = str(user.get("openId", ""))
    if result.returncode == 0 and user.get("status") == "ready":
        return open_id
    return ""


def configure(chat_id: str = "") -> int:
    if shutil.which("lark-cli"):
        resolved_chat_id = chat_id or _find_lark_channel()
        if resolved_chat_id:
            owner_open_id = _lark_owner_open_id()
            if not owner_open_id.startswith("ou_"):
                print(
                    "Lark user identity is not ready. Run: "
                    "lark-cli auth login --domain im",
                    file=sys.stderr,
                )
                return 1
            try:
                save_lark_channel(
                    resolved_chat_id,
                    owner_open_id=owner_open_id,
                    boss_root=os.environ.get("PM_BOSS_ROOT", "/Volumes/SanDisk2TB"),
                )
            except ValueError as error:
                print(str(error), file=sys.stderr)
                return 2
            print(f"Lark CLI channel configured: {resolved_chat_id}")
            return 0
        print(
            "Could not find exactly one 'Claude PM 总控' chat. "
            "Pass its oc_ chat ID: claude-feishu configure oc_xxx",
            file=sys.stderr,
        )
        return 1

    print("Paste the Feishu custom-bot webhook when macOS Keychain prompts.")
    result = subprocess.run(
        [
            "security",
            "add-generic-password",
            "-U",
            "-s",
            KEYCHAIN_SERVICE,
            "-a",
            KEYCHAIN_ACCOUNT,
            "-w",
        ],
        check=False,
    )
    if result.returncode != 0:
        print("Keychain configuration failed.", file=sys.stderr)
        return result.returncode
    print("Feishu webhook saved in macOS Keychain.")
    return 0


def show_logs(limit: int = 20) -> None:
    path = runtime_dir() / "logs" / "gateway.jsonl"
    if not path.exists():
        print("No gateway logs.")
        return
    lines = path.read_text(encoding="utf-8").splitlines()[-limit:]
    for line in lines:
        try:
            event = json.loads(line)
            print(
                f"{event.get('at', '')} | {event.get('kind', '')} | "
                f"{event.get('message', '')}"
            )
        except json.JSONDecodeError:
            continue


def test_message() -> bool:
    try:
        send_text("Claude Feishu Gateway 测试成功。")
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        return False
    print("Test message delivered.")
    return True


def execute_command(
    command: str,
    *,
    cancel_active: Optional[Callable[[], None]] = None,
) -> bool:
    normalized = " ".join(command.strip().lower().split())
    if normalized.startswith("cloud "):
        normalized = normalized[6:]
    if normalized == "on":
        set_enabled(True)
        print("Feishu sync ON.")
    elif normalized == "off":
        set_enabled(False)
        if cancel_active is not None:
            cancel_active()
        print("Feishu sync OFF.")
    elif normalized == "status":
        print(status_text())
    elif normalized == "test":
        test_message()
    elif normalized == "logs":
        show_logs()
    elif normalized in {"quit", "exit"}:
        print("Gateway stopped.")
        return False
    elif normalized:
        print("Commands: cloud on|off|status|test|logs|quit")
    return True


def console() -> int:
    try:
        gateway_lock = acquire_gateway_lock()
    except RuntimeError as error:
        print(str(error), file=sys.stderr)
        return 1
    set_enabled(True)
    print("Claude Feishu Gateway")
    print(status_text())
    try:
        send_text(
            "Claude Feishu Gateway 已上线，外出同步已开启。",
            retries=1,
            timeout=5,
        )
        append_log("online", "Gateway online")
        print("Gateway 已上线，飞书同步 ON。")
    except RuntimeError as error:
        append_log("connection-error", str(error))
        print(str(error), file=sys.stderr)

    stop_delivery = threading.Event()
    active_command = ActiveCommandCancellation()

    def delivery_worker() -> None:
        while not stop_delivery.is_set():
            try:
                deliver_pending()
            except Exception as error:
                try:
                    append_log("worker-error", type(error).__name__)
                except OSError:
                    pass
            stop_delivery.wait(0.5)

    worker = threading.Thread(
        target=delivery_worker,
        name="claude-feishu-delivery",
        daemon=True,
    )
    worker.start()

    def inbound_worker() -> None:
        while not stop_delivery.is_set():
            command_stop = active_command.begin()
            try:
                process_pending_once(stop_event=command_stop)
            except Exception as error:
                try:
                    append_log("inbound-worker-error", type(error).__name__)
                except OSError:
                    pass
            finally:
                active_command.finish(command_stop)
            stop_delivery.wait(0.5)

    inbound_delivery = threading.Thread(
        target=inbound_worker,
        name="claude-feishu-inbound-delivery",
        daemon=True,
    )
    inbound_delivery.start()

    inbound_listener = None
    if inbound_configured():
        inbound_listener = threading.Thread(
            target=listen_forever,
            args=(stop_delivery,),
            name="claude-feishu-inbound-listener",
            daemon=True,
        )
        inbound_listener.start()
    try:
        interactive = sys.stdin.isatty()
        prompt_visible = False
        while True:
            if interactive and not prompt_visible:
                print("feishu> ", end="", flush=True)
                prompt_visible = True
            ready, _, _ = select.select([sys.stdin], [], [], 0.5)
            if not ready:
                continue
            line = sys.stdin.readline()
            if line == "":
                return 0
            if not execute_command(line, cancel_active=active_command.cancel):
                return 0
            prompt_visible = False
    finally:
        stop_delivery.set()
        active_command.cancel()
        worker.join()
        inbound_delivery.join()
        if inbound_listener is not None:
            inbound_listener.join()
        gateway_lock.close()


def main(argv: list[str]) -> int:
    if not argv:
        return console()
    command = argv[0].lower()
    if command == "configure":
        return configure(argv[1] if len(argv) > 1 else "")
    if command == "on":
        set_enabled(True)
        print("Feishu sync ON.")
        return 0
    if command == "off":
        set_enabled(False)
        print("Feishu sync OFF.")
        return 0
    if command == "status":
        print(status_text())
        return 0
    if command == "test":
        return 0 if test_message() else 1
    if command == "logs":
        show_logs()
        return 0
    print(
        "Usage: claude-feishu [configure [oc_chat_id]|on|off|status|test|logs]",
        file=sys.stderr,
    )
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
